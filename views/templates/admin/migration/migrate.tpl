          <div class="ps_migration_check-item">
            <div class="ps_migration_check-icon">✓</div>
            <span class="ps_migration_check-text">{l s='Integrated multi-user management for your entire team' mod='prestascansecurity'}</span>
          </div>
          <div class="ps_migration_check-item">
            <div class="ps_migration_check-icon">✓</div>
            <span class="ps_migration_check-text">{l s='Even more features than PrestaScan' mod='prestascansecurity'}</span>
          </div>
          <div class="ps_migration_check-item">
            <div class="ps_migration_check-icon">✓</div>
            <span class="ps_migration_check-text">{l s='+80 sensors dedicated to PrestaShop management' mod='prestascansecurity'}</span>
