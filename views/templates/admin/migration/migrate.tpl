          <div class="ps_migration_feature-desc">{l s='Vulnerabilities, vulnerable modules, updates, hijacking, spam, etc.' mod='prestascansecurity'}</div>
        </div>

        <div class="ps_migration_feature">
          <svg class="ps_migration_feature-icon" viewBox="0 0 24 24" fill="none" stroke="#774CFE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
